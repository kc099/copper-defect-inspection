<Window x:Class="copperInspection.StripRunsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:copperInspection"
        Title="Strip Runs"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E1C">

    <Window.Resources>
        <Style x:Key="RunBtn" TargetType="Button">
            <Setter Property="Background" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#33335A"/>
                                <Setter Property="Foreground" Value="#555577"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9090B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- One run in the left-hand list. -->
        <DataTemplate x:Key="RunRow">
            <Border Background="#1A1A2E" CornerRadius="6" Margin="0,0,0,6"
                    BorderBrush="#2A2A44" BorderThickness="1" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayText}" Foreground="#E8E8F8"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SummaryText}" Foreground="#8080A8"
                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Verdict}" FontSize="11" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="#9090B8"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One segment tick in the strip map. Colour is set in code from the
             segment's outcome, because it comes from two sources (the report's
             defect count and the run's missing-segment list). -->
        <DataTemplate x:Key="SegmentTick">
            <Border Width="16" Height="54" Margin="1,0" CornerRadius="2"
                    Background="{Binding Fill}" Cursor="Hand"
                    ToolTip="{Binding Tip}"
                    MouseLeftButtonUp="SegmentTick_Click">
                <TextBlock Text="{Binding Label}" Foreground="#0E0E1C" FontSize="8"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,2"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── LEFT: run list ─── -->
        <Border Grid.Column="0" Background="#141426" CornerRadius="10" Margin="12,12,6,12" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="🧾  Strip Runs" Foreground="#D8D8F0"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="From" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="FromDate" Margin="0,0,0,8"/>
                    <TextBlock Text="To" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="ToDate" Margin="0,0,0,10"/>
                    <Button Content="🔍  Load Date Range" Style="{StaticResource RunBtn}"
                            HorizontalAlignment="Stretch" Click="LoadRange_Click" Margin="0,0,0,6"/>
                    <Button Content="🕒  Recent Runs" Style="{StaticResource RunBtn}"
                            HorizontalAlignment="Stretch" Click="LoadRecent_Click"/>
                </StackPanel>

                <TextBlock x:Name="RunCountLabel" DockPanel.Dock="Bottom" Text=""
                           Foreground="#6C6C9C" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <ListBox x:Name="RunsList" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource RunRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="RunsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ─── RIGHT: the selected run ─── -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="4,0,0,10">
                <TextBlock x:Name="RunTitle" Text="Select a run"
                           Foreground="#E8E8F8" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="RunSubtitle" Text="" Foreground="#8080A8"
                           FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Coverage banner: the single most important thing on this page.
                 An incomplete run means part of the strip was never looked at,
                 whatever the verdict says. -->
            <Border x:Name="CoverageBanner" Grid.Row="1" CornerRadius="6" Padding="12,9"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="CoverageText" Foreground="White" FontSize="12"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Strip map -->
            <Border Grid.Row="2" Background="#0A0A16" CornerRadius="8"
                    BorderBrush="#2A2A44" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Strip Map" Foreground="#D8D8F0" FontSize="13"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#22C55E"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="good" Foreground="#8080A8" FontSize="11" Margin="5,0,12,0"/>
                            <Border Width="10" Height="10" CornerRadius="2" Background="#EF4444"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="defect" Foreground="#8080A8" FontSize="11" Margin="5,0,12,0"/>
                            <Border Width="10" Height="10" CornerRadius="2" Background="#6B7280"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="not inspected" Foreground="#8080A8" FontSize="11" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="StripMap">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="SegmentTick"/>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MapHint" Text="" Foreground="#5C5C8C"
                                       FontSize="11" Margin="2,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Defect table -->
            <Border Grid.Row="3" Background="#0A0A16" CornerRadius="8"
                    BorderBrush="#2A2A44" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="DefectsHeader" Text="Defects"
                               Foreground="#D8D8F0" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock DockPanel.Dock="Top" x:Name="DefectsEmpty"
                               Text="No defects recorded for this run."
                               Foreground="#4A4A6A" FontSize="12" Visibility="Collapsed"/>

                    <DataGrid x:Name="DefectsGrid" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="#141426" AlternatingRowBackground="#181830"
                              Foreground="#D8D8F0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2A2A44"
                              HeadersVisibility="Column" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              MouseDoubleClick="DefectsGrid_DoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                   xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
                                <Setter Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="#9090B8"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46"/>
                            <DataGridTextColumn Header="Position along strip" Binding="{Binding Range}" Width="190"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="90"/>
                            <DataGridTextColumn Header="Across strip" Binding="{Binding Across}" Width="170"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="90"/>
                            <DataGridTextColumn Header="Seen in segments" Binding="{Binding Segments}" Width="150"/>
                            <DataGridTextColumn Header="Sightings merged" Binding="{Binding Merged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
