<Window x:Class="copperInspection.LiveMaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Mask - Live"
        Height="560" Width="720"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="#0E0E1C">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
            <Border Background="#142A1E" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                <TextBlock x:Name="SegmentLabel" Text="waiting for the first segment…"
                           Foreground="#66FF99" FontSize="12" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="CountLabel" Text="0 segments shown"
                       Foreground="#8080A8" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#000000" CornerRadius="5" BorderBrush="#2A2A44" BorderThickness="1">
            <Grid>
                <Image x:Name="MaskImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="EmptyLabel" Text="No mask received yet."
                           Foreground="#4A4A6A" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
