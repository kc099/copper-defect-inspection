<Window x:Class="copperInspection.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:copperInspection"
        Title="Inspection Reports"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E1C">

    <Window.Resources>
        <local:BytesToImageConverter x:Key="BytesToImage"/>

        <Style x:Key="ReportBtn" TargetType="Button">
            <Setter Property="Background" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#33335A"/>
                                <Setter Property="Foreground" Value="#555577"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smaller flat button used inside each card -->
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource ReportBtn}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9090B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- One result card: image + defect count + date/time + View / Download.
             Stretches to fill its grid cell. -->
        <DataTemplate x:Key="ReportCard">
            <Border Background="#1A1A2E" CornerRadius="8" Margin="6"
                    BorderBrush="#2A2A44" BorderThickness="1" Padding="8">
                <Grid x:Name="CardBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#000000" CornerRadius="5" MinHeight="80">
                        <Grid>
                            <Image Source="{Binding ImageData, Converter={StaticResource BytesToImage}}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="CardEmptyNote" Text="Empty slot"
                                       Foreground="#3A3A5A" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CardCount" Grid.Row="1"
                               Text="{Binding DefectCount, StringFormat={}{0} defect(s)}"
                               Foreground="#EF6B6B" FontSize="14" FontWeight="Bold"
                               Margin="2,8,0,0"/>
                    <TextBlock x:Name="CardTime" Grid.Row="2" Text="{Binding DisplayText}"
                               Foreground="#9090B8" FontSize="11" Margin="2,3,0,0"/>

                    <!-- Where on the strip it happened - only strip-scan reports
                         have this; a manually captured report leaves it blank
                         and this row just takes no visible space. -->
                    <TextBlock x:Name="CardPositions" Grid.Row="3" Text="{Binding PositionsText}"
                               Foreground="#F0B33C" FontSize="10" FontWeight="SemiBold"
                               Margin="2,3,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardMethod" Grid.Row="4" Text="{Binding Method}"
                               Foreground="#5C5C8C" FontSize="10" Margin="2,2,0,0"/>

                    <StackPanel x:Name="CardActions" Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔎  View" Style="{StaticResource CardBtn}"
                                Click="CardView_Click" Margin="0,0,6,0"/>
                        <Button Content="⬇  Download" Style="{StaticResource CardBtn}"
                                Click="CardDownload_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- An unfilled live slot: keep the frame, drop everything inside it. -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="CardBody"      Property="Opacity"    Value="0.35"/>
                    <Setter TargetName="CardCount"     Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CardTime"      Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CardPositions" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CardMethod"    Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CardActions"   Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CardEmptyNote" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="LivePanel">
            <UniformGrid Rows="2" Columns="3"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RangePanel">
            <WrapPanel Orientation="Horizontal" ItemWidth="290" ItemHeight="310"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── LEFT PANEL: date filter + actions ─── -->
        <Border Grid.Column="0" Background="#1A1A2E" CornerRadius="10" Margin="12,12,6,12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="📅  Date Range" Foreground="#D8D8F0" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Text="From" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="FromDate" Margin="0,0,0,10"/>

                    <TextBlock Text="To" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="ToDate" Margin="0,0,0,14"/>

                    <Button Content="🔍  Load Date Range" Style="{StaticResource ReportBtn}"
                            HorizontalAlignment="Stretch" Click="LoadRange_Click" Margin="0,0,0,8"/>
                    <Button Content="🕒  Live — Last 6" Style="{StaticResource ReportBtn}"
                            HorizontalAlignment="Stretch" Click="LoadRecent_Click" Margin="0,0,0,16"/>

                    <Border Background="#2A2A44" Height="1" Margin="0,0,0,16"/>

                    <Button x:Name="DownloadAllBtn" Content="⬇  Download All Shown"
                            Style="{StaticResource ReportBtn}" HorizontalAlignment="Stretch"
                            Click="DownloadAll_Click" IsEnabled="False" Margin="0,0,0,12"/>

                    <TextBlock x:Name="CountLabel" Text="" Foreground="#6C6C9C" FontSize="11"
                               TextWrapping="Wrap"/>

                    <!-- Shown only in date-range mode, when live results arrived meanwhile. -->
                    <TextBlock x:Name="LiveHintLabel" Foreground="#38BDF8" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── MAIN: gallery of result cards ─── -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderLabel" Grid.Row="0" Text="Recent Runs"
                       Foreground="#E8E8F8" FontSize="16" FontWeight="Bold" Margin="4,0,0,8"/>

            <Border Grid.Row="1" Background="#0A0A16" CornerRadius="8"
        BorderBrush="#2A2A44" BorderThickness="1">
                <Grid>
                    <ScrollViewer x:Name="GalleryScroll"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ReportsItems"
                          ItemTemplate="{StaticResource ReportCard}"
                          ItemsPanel="{StaticResource LivePanel}"
                          Margin="6"/>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyLabel" Text="No reports to show."
                   Foreground="#4A4A6A" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
